# Set this to the Supabase Transaction Pooler connection URI.
# Use the pooler connection details from Supabase > Connect.
DATABASE_URL="postgresql://postgres.PROJECT_REF:YOUR_DATABASE_PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?sslmode=require"
APP_SESSION_SECRET="generate-a-long-random-secret"
CRON_SECRET="generate-a-separate-vercel-cron-secret"
